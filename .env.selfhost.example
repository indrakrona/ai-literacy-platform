PUBLIC_URL=https://ailearning.impact.id
DB_PASSWORD=change-me
PAYLOAD_SECRET=change-me-to-a-long-random-string
STORAGE_USER=ailit
STORAGE_PASSWORD=change-me-too
ANTHROPIC_API_KEY=

# Payments — PLACEHOLDER (see docs/payments.md). Keep "mock" until a gateway is connected.
PAYMENTS_PROVIDER=mock
PAYMENTS_WEBHOOK_SECRET=change-me
PAYMENTS_ALLOW_MOCK=true
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Email (optional until a provider is chosen)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@ailearning.impact.id

# Scheduled jobs (test reminders, weekly parent summary, announcements). Any long random string.
CRON_SECRET=change-me-to-another-long-random-string

# WhatsApp (see docs/whatsapp.md). "console" only writes messages to the log; "meta" sends via the Cloud API.
WHATSAPP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Google sign-in (optional, see docs/sign-in.md). The button appears once both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
