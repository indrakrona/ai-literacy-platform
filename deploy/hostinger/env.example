# Project environment for deploy/hostinger/docker-compose.yml (Docker manager → project → Environment).
# Generate each secret with:  openssl rand -hex 32
DOMAIN=ailearning.impact.id
IMAGE_TAG=main
DB_PASSWORD=
PAYLOAD_SECRET=
CRON_SECRET=
OPS_SECRET=
PAYMENTS_WEBHOOK_SECRET=
BACKUP_KEEP_DAYS=14

# Optional, add when the accounts exist (then "Update" the project):
ANTHROPIC_API_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@ailearning.impact.id
# Staging: print emails to the app log while SMTP is not set. Set to false before real students use the site.
EMAIL_TO_LOG=true
PAYMENTS_PROVIDER=mock
PAYMENTS_ALLOW_MOCK=true
WHATSAPP_PROVIDER=console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
