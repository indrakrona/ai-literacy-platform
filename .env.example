# Copy to apps/web/.env for local development.
DATABASE_URI=postgres://ailit:ailit@127.0.0.1:5432/ailit_dev
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000   # production: https://ailearning.impact.id

# Media storage (optional locally; required in staging/production)
S3_BUCKET=
S3_REGION=asia-southeast2
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI gateway
ANTHROPIC_API_KEY=

# Payments — PLACEHOLDER (see docs/payments.md). Only "mock" works today.
PAYMENTS_PROVIDER=mock            # mock | midtrans | xendit
PAYMENTS_WEBHOOK_SECRET=          # mock provider signature secret
PAYMENTS_ALLOW_MOCK=              # set to true to allow test payments when NODE_ENV=production
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# Analytics (optional). First-party events always work; these only add external tools.
NEXT_PUBLIC_GA_ID=                # GA4 measurement ID, public website only, after cookie consent
POSTHOG_KEY=                      # PostHog project key; events forwarded server-side, no replays
POSTHOG_HOST=https://eu.i.posthog.com
AI_COST_PER_MTOK_USD=5            # rough blended AI cost for the dashboard estimate

# Email (optional until a provider is chosen). Without SMTP: development prints emails (with links) to the
# console; production sends nothing, and teachers/school admins share consent links by WhatsApp instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@ailearning.impact.id
EMAIL_FROM_NAME=AI Literacy · Impact Thinklab
